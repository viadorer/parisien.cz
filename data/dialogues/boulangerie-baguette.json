      "role": {
        "fr": "Le boulanger",
        "cs": "Pekař"
      },
      "fr": "Normale ou de tradition ?",
      "cs": "Obyčejnou, nebo tradiční?"
    },
    {
      "who": "A",
      "role": {
        "fr": "La cliente",
        "cs": "Zákaznice"
      },
      "fr": "De tradition, s'il vous plaît.",
      "cs": "Tradiční, prosím."
    },
    {
      "who": "B",
      "role": {
        "fr": "Le boulanger",
        "cs": "Pekař"
      },
      "fr": "Voilà. Et avec ça ?",
      "cs": "Tady máte. A k tomu něco?"
    },
    {
      "who": "A",
      "role": {
        "fr": "La cliente",
        "cs": "Zákaznice"
      },
      "fr": "Je voudrais aussi un croissant.",
      "cs": "Chtěla bych ještě croissant."
    },
    {
      "who": "B",
      "role": {
        "fr": "Le boulanger",
        "cs": "Pekař"
      },
      "fr": "Un croissant. C'est tout ?",
      "cs": "Jeden croissant. To je všechno?"
    },
    {
      "who": "A",
      "role": {
        "fr": "La cliente",
        "cs": "Zákaznice"
      },
      "fr": "Oui, c'est tout. Merci.",
      "cs": "Ano, to je všechno. Děkuji."
    },
    {
      "who": "B",
      "role": {
        "fr": "Le boulanger",
        "cs": "Pekař"
      },
      "fr": "Bonne journée, madame !",
      "cs": "Hezký den, paní!"
    },
    {
      "who": "A",
      "role": {
        "fr": "La cliente",
        "cs": "Zákaznice"
      },
      "fr": "Merci, vous aussi. Au revoir !",
      "cs": "Děkuji, vám také. Na shledanou!"
    }
